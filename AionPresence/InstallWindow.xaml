<Window x:Class="AionPresence.InstallWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Width="760" Height="610" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
    Background="#091525" Foreground="#ECF3FA" FontFamily="Segoe UI"
    UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="35" ResizeBorderThickness="0" CornerRadius="18" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary Source="PresenceTheme.xaml"/></Window.Resources>
    <Border x:Name="RootSurface" CornerRadius="18" BorderThickness="1" BorderBrush="#6AADC9" ClipToBounds="True">
        <Border.Background><ImageBrush ImageSource="Assets/UI/background.png" Stretch="UniformToFill"/></Border.Background>
        <Grid Margin="28,8,28,24">
            <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="89"/><RowDefinition Height="*"/><RowDefinition Height="74"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="HeaderDrag">
                <TextBlock Text="{Binding SetupCaption}" FontSize="12" Foreground="#B7D0E3" Margin="2,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ChromeButton}" Click="MinimizeClick" AutomationProperties.Name="Minimize"><Path Data="M0,5 H12" Stroke="#D8E8F3" StrokeThickness="1.3" Width="12"/></Button>
                    <Button Style="{StaticResource ChromeButton}" Click="CloseClick" AutomationProperties.Name="Close"><Path Data="M1,1 L11,11 M11,1 L1,11" Stroke="#D8E8F3" StrokeThickness="1.3" Width="12" Height="12"/></Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,12,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="{Binding Logo}" Width="46" Height="46" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="AION2 Presence" FontSize="29" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Tagline}" FontSize="13" Foreground="#C4D6E5" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource ActionButton}" Padding="12,7" VerticalAlignment="Center" Click="LanguageClick" AutomationProperties.Name="{Binding LanguageLabel}">
                    <Button.ContextMenu><ContextMenu Placement="Bottom">
                        <MenuItem Header="English" Click="EnglishClick"><MenuItem.Icon><Image Source="{StaticResource FlagUK}" Width="24" Height="16"/></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Polski" Click="PolishClick"><MenuItem.Icon><Image Source="{StaticResource FlagPL}" Width="24" Height="16"/></MenuItem.Icon></MenuItem>
                    </ContextMenu></Button.ContextMenu>
                    <StackPanel Orientation="Horizontal"><Image Source="{Binding LanguageFlag}" Width="24" Height="16" Margin="0,0,8,0"/><TextBlock Text="{Binding LanguageCode}" FontSize="15"/><TextBlock Text="⌄" FontSize="16" Margin="8,-2,0,0"/></StackPanel>
                </Button>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24,22">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="19" BorderBrush="{Binding Accent}" BorderThickness="1" Background="#302B6B77" Margin="0,0,13,0">
                            <TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding Accent}" FontSize="23" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="#B7D0E3" Margin="0,3,0,0"/></StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,18">
                        <TextBlock Text="{Binding Description}" FontSize="15" Foreground="#D3E4F0" LineHeight="24" TextWrapping="Wrap" VerticalAlignment="Top"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding FolderLabel}" FontSize="13" Foreground="#B7D0E3" Margin="0,0,0,8"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Background="#B90B2033" BorderBrush="#638EA9" BorderThickness="1" CornerRadius="7" Padding="12,10">
                                <TextBox x:Name="FolderInput" Text="{Binding Folder,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding FolderReadOnly}"
                                    Background="Transparent" Foreground="#ECF3FA" CaretBrush="#8DE5EE" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"
                                    SelectionBrush="#377E93" AutomationProperties.Name="{Binding FolderLabel}" HorizontalScrollBarVisibility="Auto"/>
                            </Border>
                            <Button Grid.Column="1" Content="{Binding BrowseText}" Style="{StaticResource ActionButton}" FontSize="14" Padding="16,9" Margin="10,0,0,0" Click="BrowseClick" IsEnabled="{Binding CanEdit}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="3" Margin="1,20,0,0">
                <TextBlock Text="{Binding Footer}" TextWrapping="Wrap" FontSize="12" Foreground="#B7D0E3" MaxWidth="420" HorizontalAlignment="Left"/>
                <Button Content="{Binding ActionText}" Style="{StaticResource ActionButton}" Background="{StaticResource GoldFill}" Foreground="#142638" BorderBrush="#FFE5A0"
                    FontWeight="SemiBold" FontSize="16" Padding="26,12" MinWidth="160" HorizontalAlignment="Right" IsEnabled="{Binding CanAct}" Click="ActionClick" IsDefault="True"/>
            </Grid>
        </Grid>
    </Border>
</Window>

